{
  "$extensions": {
    "com.orion.brand": {
      "id": "failclosed-site",
      "name": "failclosed",
      "archetype": "WorksTechnicalMonograph",
      "polarity": "dark",
      "domain": "danmercede.com/works/failclosed/"
    },
    "com.orion.contrastPairs": [
      { "name": "body-on-bg", "fg": "color.fg", "bg": "color.bg", "level": "normal" },
      { "name": "body-on-surface", "fg": "color.fg", "bg": "color.surface", "level": "normal" },
      { "name": "body-on-elevated", "fg": "color.fg", "bg": "color.surfaceElevated", "level": "normal" },
      { "name": "prose-on-bg", "fg": "color.fgSecondary", "bg": "color.bg", "level": "normal" },
      { "name": "muted-on-bg", "fg": "color.fgMuted", "bg": "color.bg", "level": "normal" },
      { "name": "muted-on-surface", "fg": "color.fgMuted", "bg": "color.surface", "level": "normal" },
      { "name": "muted-on-elevated", "fg": "color.fgMuted", "bg": "color.surfaceElevated", "level": "normal" },
      { "name": "cta-label-on-accent", "fg": "color.accentFg", "bg": "color.accent", "level": "normal" },
      { "name": "cta-label-on-hover", "fg": "color.accentFg", "bg": "color.accentHover", "level": "normal" },
      { "name": "accent-text-on-bg", "fg": "color.accentHover", "bg": "color.bg", "level": "normal" },
      { "name": "accent-text-on-surface", "fg": "color.accentHover", "bg": "color.surface", "level": "normal" },
      { "name": "border-on-bg", "fg": "color.border", "bg": "color.bg", "level": "ui" },
      { "name": "status-ok-on-surface", "fg": "color.statusOk", "bg": "color.surface", "level": "normal" },
      { "name": "status-warn-on-surface", "fg": "color.statusWarn", "bg": "color.surface", "level": "normal" },
      { "name": "status-fail-on-surface", "fg": "color.statusFail", "bg": "color.surface", "level": "normal" }
    ]
  },
  "color": {
    "bg": { "$type": "color", "$value": "#020B29", "$description": "Midnight Navy ground" },
    "surface": { "$type": "color", "$value": "#07143A", "$description": "Deep Navy sticky rail and code plates" },
    "surfaceElevated": { "$type": "color", "$value": "#0E1F4F", "$description": "Elevated monograph card surface" },
    "border": { "$type": "color", "$value": "#64748B", "$description": "Visible structural hairline (>=3:1)" },
    "borderSubtle": { "$type": "color", "$value": "#1E293B", "$description": "Subtle divider" },
    "fg": { "$type": "color", "$value": "#F8FAFC", "$description": "Primary archival ink" },
    "fgSecondary": { "$type": "color", "$value": "#E2E8F0", "$description": "Long-form monograph prose ink" },
    "fgMuted": { "$type": "color", "$value": "#94A3B8", "$description": "Metadata and comment slate" },
    "accent": { "$type": "color", "$value": "#E68249", "$description": "Copper Mid primary CTA fill" },
    "accentHover": { "$type": "color", "$value": "#F0975A", "$description": "Copper 400 hover state and inline markers" },
    "accentFg": { "$type": "color", "$value": "#020B29", "$description": "Midnight Navy ink on solid copper fills" },
    "focusRing": { "$type": "color", "$value": "#FFC08B", "$description": "Copper Light focus indicator" },
    "statusOk": { "$type": "color", "$value": "#4ADE80", "$description": "Emerald MERGE_READY status" },
    "statusWarn": { "$type": "color", "$value": "#FBBF24", "$description": "Amber BOTS_PENDING / THREADS_UNRESOLVED status" },
    "statusFail": { "$type": "color", "$value": "#F87171", "$description": "Coral FINDINGS_REMAIN fail-closed block" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "'Newsreader Variable', 'Newsreader', Georgia, serif" },
    "sans": { "$type": "fontFamily", "$value": "'IBM Plex Sans Variable', 'IBM Plex Sans', system-ui, sans-serif" },
    "mono": { "$type": "fontFamily", "$value": "'JetBrains Mono Variable', 'JetBrains Mono', monospace" }
  }
}
